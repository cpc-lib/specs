{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string"
    },
    "eventType": {
      "const": "inventory.return.disposition-posted.v1"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "traceId": {
      "type": "string"
    },
    "correlationId": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "returnNo",
        "skuId",
        "quantity",
        "dispositionType"
      ],
      "properties": {
        "returnNo": {
          "type": "string"
        },
        "skuId": {
          "type": "integer"
        },
        "quantity": {
          "type": "integer"
        },
        "dispositionType": {
          "type": "string"
        }
      }
    }
  }
}
